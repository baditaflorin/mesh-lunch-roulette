{
  "name": "mesh-lunch-roulette",
  "version": "0.1.1",
  "description": "Peer-to-peer mesh: weekly coffee-chat pairing for teams. History-aware so no two people repeat until everyone has met.",
  "type": "module",
  "private": false,
  "homepage": "https://baditaflorin.github.io/mesh-lunch-roulette/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baditaflorin/mesh-lunch-roulette.git"
  },
  "bugs": {
    "url": "https://github.com/baditaflorin/mesh-lunch-roulette/issues"
  },
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "bash scripts/build-pages.sh",
    "preview": "vite preview --host 0.0.0.0",
    "pages-preview": "vite preview --host 0.0.0.0 --port 4174",
    "test": "npm run test:unit && npm run test:e2e",
    "smoke": "bash scripts/smoke.sh",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:install": "playwright install chromium",
    "test:leak": "MESH_RUN_LEAK_TEST=1 playwright test tests/e2e/memory-leak.spec.ts"
  },
  "dependencies": {
    "@baditaflorin/mesh-common": "file:../mesh-common",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "y-webrtc": "^10.3.0",
    "yjs": "^13.6.27"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.50.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "ws": "^8.21.0"
  },
  "engines": {
    "node": ">=22"
  }
}
